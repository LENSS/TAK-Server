<infinispan xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="urn:infinispan:config:14.0 https://infinispan.org/schemas/infinispan-config-14.0.xsd"
            xmlns="urn:infinispan:config:14.0"
            xmlns:dynamodb="urn:infinispan:config:store:dynamodb:3.0">

    <!-- ************************************************************************************* -->
    <!-- For more information see https://connect2id.com/products/server/docs/config/infinispan -->
    <!-- ************************************************************************************* -->

    <cache-container name="c2id.cluster" default-cache="sessionStore.sessionMap" statistics="true">

        <local-cache-configuration name="base">
            <expiration interval="0"/>
            <memory max-count="1" when-full="MANUAL"/>
        </local-cache-configuration>

        <!-- ************************* -->
        <!-- *** Key store objects *** -->
        <!-- ************************* -->

        <!-- JWK sets -->
        <local-cache name="keyStore.jwkSetMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                        region="${dynamodb.region:}"
                        endpoint="${dynamodb.endpoint:}"
                        http-proxy-host="${dynamodb.httpProxyHost:}"
                        http-proxy-port="${dynamodb.httpProxyPort:-1}"
                        item-transformer="com.nimbusds.keystore.impl.persistence.dynamodb.JWKSetTransformer"
                        encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                        hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                        stream="${dynamodb.enableStream:false}"
                        continuous-backups="${dynamodb.enableContBackups:false}"
                        table-prefix="${dynamodb.tablePrefix:}"
                        apply-range-key="${dynamodb.applyRangeKey:}"
                        range-key-value="${dynamodb.rangeKeyValue:}"
                        deletion-protection="${dynamodb.enableDeletionProtection:false}"
                        segmented="false"/>
            </persistence>
        </local-cache>

        <!-- JWK sets history -->
        <local-cache name="keyStore.jwkSetHistoryMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                        region="${dynamodb.region:}"
                        endpoint="${dynamodb.endpoint:}"
                        http-proxy-host="${dynamodb.httpProxyHost:}"
                        http-proxy-port="${dynamodb.httpProxyPort:-1}"
                        item-transformer="com.nimbusds.keystore.impl.persistence.dynamodb.JWKSetHistoryTransformer"
                        encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                        hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                        stream="${dynamodb.enableStream:false}"
                        continuous-backups="${dynamodb.enableContBackups:false}"
                        table-prefix="${dynamodb.tablePrefix:}"
                        apply-range-key="${dynamodb.applyRangeKey:}"
                        range-key-value="${dynamodb.rangeKeyValue:}"
                        deletion-protection="${dynamodb.enableDeletionProtection:false}"
                        segmented="false"/>
            </persistence>
        </local-cache>

        <!-- ***************************** -->
        <!-- *** Session store objects *** -->
        <!-- ***************************** -->

        <!-- End-user sessions -->
        <local-cache name="sessionStore.sessionMap" configuration="base">
            <expiration interval="${sessionStore.sessionMap.expirationInterval:600000}"/>
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.sessionstore.impl.persistence.dynamodb.SubjectSessionTransformer"
                    consistent-reads="${dynamodb.consistentReads.sessionStore.sessionMap:false}"
                    ttl="${dynamodb.enableTTL.sessionStore.sessionMap:false}"
                    purge-max-read-capacity="${dynamodb.purgeMaxReadCapacity:10%}"
                    purge-limit="${dynamodb.purgeLimit.sessionStore.sessionMap:-1}"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- End-user session index -->
        <local-cache name="sessionStore.subjectMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.sessionstore.impl.persistence.dynamodb.SubjectIndexTransformer"
                    ttl="true"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>


        <!-- *********************************** -->
        <!-- *** Authorisation store objects *** -->
        <!-- *********************************** -->

        <!-- Pending authorisation codes -->
        <local-cache name="authzStore.codeMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.authzstore.impl.persistence.dynamodb.PendingAuthorizationCodeTransformer"
                    ttl="true"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Identifier-based access tokens -->
        <local-cache name="authzStore.idAccessTokenMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.authzstore.impl.persistence.dynamodb.IDAccessTokenTransformer"
                    ttl="true"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    continuous-backups="${dynamodb.enableContBackups:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Long-lived authorisations -->
        <local-cache name="authzStore.longLivedAuthzMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.authzstore.impl.persistence.dynamodb.AuthorizationRecordTransformer"
                    query-executor="com.nimbusds.infinispan.persistence.dynamodb.query.SimpleMatchQueryExecutor"
                    index-attributes="${dynamodb.authzStore.longLivedAuthzMap.indexedAttributes:sub, act, cid}"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    continuous-backups="${dynamodb.enableContBackups:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Revocation journal -->
        <local-cache name="authzStore.revocationJournalMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.authzstore.impl.persistence.dynamodb.RevocationRecordTransformer"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    continuous-backups="${dynamodb.enableContBackups:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Expended tokens -->
        <local-cache name="authzStore.expendedTokenMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.authzstore.impl.persistence.dynamodb.ExpendedTokenTransformer"
                    ttl="true"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>


        <!-- ************************* -->
        <!-- Connect2id server objects -->
        <!-- ************************* -->

        <!-- Pending authentications at the authorisation endpoint -->
        <local-cache name="op.authSessionMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.openid.connect.provider.authz.session.persistence.dynamodb.AuthenticationSessionTransformer"
                    ttl="true"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Pending consents at the authorisation endpoint -->
        <local-cache name="op.consentSessionMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.openid.connect.provider.authz.session.persistence.dynamodb.ConsentSessionTransformer"
                    consistent-reads="true"
                    ttl="true"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- OAuth 2.0 clients -->
        <local-cache name="clients.registrationsMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.openid.connect.provider.reg.store.persistence.dynamodb.OIDCClientInformationTransformer"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    continuous-backups="${dynamodb.enableContBackups:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Federation clients tracker -->
        <local-cache name="federation.registrationsMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.openid.connect.provider.federation.reg.store.persistence.dynamodb.FederationClientTransformer"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    continuous-backups="${dynamodb.enableContBackups:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- CIBA login hint tokens -->
        <local-cache name="op.loginHintTokenMap" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                        region="${dynamodb.region:}"
                        endpoint="${dynamodb.endpoint:}"
                        http-proxy-host="${dynamodb.httpProxyHost:}"
                        http-proxy-port="${dynamodb.httpProxyPort:-1}"
                        item-transformer="com.nimbusds.openid.connect.provider.sts.ciba.persistence.dynamodb.LoginHintTokenTransformer"
                        ttl="true"
                        encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                        hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                        stream="${dynamodb.enableStream:false}"
                        table-prefix="${dynamodb.tablePrefix:}"
                        apply-range-key="${dynamodb.applyRangeKey:}"
                        range-key-value="${dynamodb.rangeKeyValue:}"
                        deletion-protection="${dynamodb.enableDeletionProtection:false}"
                        segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Cached remote client JWK sets -->
        <local-cache name="clients.remoteJWKSetCache" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.openid.connect.provider.reg.store.persistence.dynamodb.RemoteJWKSetTransformer"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

        <!-- Cached remote request JWT objects -->
        <local-cache name="clients.remoteRequestJWTClaimsCache" configuration="base">
            <persistence>
                <dynamodb:dynamodb-store
                    region="${dynamodb.region:}"
                    endpoint="${dynamodb.endpoint:}"
                    http-proxy-host="${dynamodb.httpProxyHost:}"
                    http-proxy-port="${dynamodb.httpProxyPort:-1}"
                    item-transformer="com.nimbusds.openid.connect.provider.reg.store.persistence.dynamodb.RemoteRequestJWTTransformer"
                    encryption-at-rest="${dynamodb.encryptionAtRest:false}"
                    hmac-sha256-key="${dynamodb.hmacSHA256Key:}"
                    stream="${dynamodb.enableStream:false}"
                    table-prefix="${dynamodb.tablePrefix:}"
                    apply-range-key="${dynamodb.applyRangeKey:}"
                    range-key-value="${dynamodb.rangeKeyValue:}"
                    deletion-protection="${dynamodb.enableDeletionProtection:false}"
                    segmented="false"/>
            </persistence>
        </local-cache>

    </cache-container>

</infinispan>