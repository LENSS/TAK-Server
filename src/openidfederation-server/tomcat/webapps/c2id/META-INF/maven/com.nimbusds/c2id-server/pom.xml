    <profiles>
        <profile>
            <!-- Multi-tenant edition -->
            <id>mt</id>
            <dependencies>
                <dependency>
                    <groupId>com.nimbusds</groupId>
                    <artifactId>tenant-registry</artifactId>
                    <version>9.0.1</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-war-plugin</artifactId>
                        <configuration>
                            <classifier>mt</classifier>
                            <archive>
                                <manifestEntries>
                                    <Build-Date>${timestamp}</Build-Date>
                                    <Build-Number>${buildNumber}</Build-Number>
                                    <Build-Tag>${project.scm.tag}</Build-Tag>
                                    <Built-By>connect2id</Built-By>
                                </manifestEntries>
                            </archive>
                            <archiveClasses>true</archiveClasses>
                            <filters>src/main/build-profiles/web-xml-mt.properties</filters>
                            <webResources>
                                <resource>
                                    <filtering>true</filtering>
                                    <directory>src/main/webapp</directory>
                                    <includes>
                                        <include>**/web.xml</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <filtering>false</filtering>
                                    <directory>src/main/build-profiles/configs/multi-tenant</directory>
                                    <targetPath>WEB-INF</targetPath>
                                </resource>
                                <resource>
                                    <filtering>false</filtering>
                                    <directory>src/main/build-profiles/configs/single-tenant</directory>
                                    <targetPath>WEB-INF/tenant-config-reference</targetPath>
                                    <includes>
                                        <include>oidcProvider.properties</include>
                                        <include>authzStore.properties</include>
                                        <include>sessionStore.properties</include>
                                        <include>customClaimsMap.properties</include>
                                        <include>claimsCompression.properties</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <filtering>false</filtering>
                                    <directory>target/sql-mt</directory>
                                    <targetPath>WEB-INF/sql</targetPath>
                                </resource>
                                <resource>
                                    <filtering>true</filtering>
                                    <directory>target</directory>
                                    <includes>
